{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* --- The cross-boundary type bridge -----------------------------------
       `@backend/*` -> the Nest project's SOURCE (not its dist), so the
       contract can never be stale. src/trpc.ts does:
           import type { AppRouter } from '@backend/trpc/trpc.router.js'
       which is the alias form of
           import type { AppRouter } from '../../nest-trpc-poc/src/trpc/trpc.router.js'

       tsc follows that import into the Nest sources, so this config has to be
       able to type-check *them* too. That is what the three settings below are
       for -- they are not needed by any file in src/:
         experimentalDecorators         -> @Injectable() / @InjectRepository()
         strictPropertyInitialization:false -> `id: number;` on the User entity
         and `erasableSyntaxOnly` had to go: Nest uses constructor parameter
         properties, which that flag forbids.

       `moduleResolution: bundler` still remaps the backend's nodenext-style
       './user.entity.js' specifiers onto the real .ts files.
       None of this reaches the browser: the import is type-only, so Vite
       never sees it and no server code is bundled. */
    "paths": {
      "@backend/*": ["../nest-trpc-poc/src/*"]
    },
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Off because tsc also checks the Nest sources reached through
       `@backend/*`, and those are written for the Nest tsconfig, which does
       not enable this (e.g. user.service.ts does `import { Gender, User }`).
       The type-only import in trpc.ts is still written as `import type`, so it
       is erased either way and no server code reaches the bundle. */
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
